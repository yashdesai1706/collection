# ==============================================================================
# PRITI'S COLLECTION - UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/pritis-collection?retryWrites=true&w=majority

# Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here_super_secure

# Razorpay Payment Gateway (Online Payments Only)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Public URL (Leave empty or set to relative /api for unified deployment)
NEXT_PUBLIC_API_URL=/api

# Optional: Nodemailer SMTP for boutique contact form
EMAIL_USER=boutique@example.com
EMAIL_PASS=your_email_app_password

# Optional: Production CORS Allowed Origin
FRONTEND_URL=https://pritiscollection.com

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
